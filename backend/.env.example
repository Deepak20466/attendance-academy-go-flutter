APP_ENV=development
PORT=8080

# postgres://user:password@host:5432/dbname?sslmode=disable
DATABASE_URL=postgres://attendance_user:changeme@localhost:5432/attendance_db?sslmode=disable

# Generate strong random secrets, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Firebase Cloud Messaging (service account JSON for HTTP v1 API)
FCM_PROJECT_ID=your-firebase-project-id
FCM_CREDENTIALS_FILE=./secrets/firebase-service-account.json

GEOFENCE_DEFAULT_RADIUS_METERS=100
ATTENDANCE_REMINDER_MINUTES=15
